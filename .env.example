# ==============================================================================
# Shiksha Elite Production Environment Variables
# ==============================================================================
# Configure these variables in your hosting environment (Netlify / Vercel / Server):
# Site configuration > Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Resend Email Service Integration (Required for Contact Notifications)
# ------------------------------------------------------------------------------
# Your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified domain sender (e.g. "Shiksha Elite <contact@shikshaelite.com>")
# For testing without a verified custom domain, use: "Shiksha Elite <onboarding@resend.dev>"
RESEND_FROM_EMAIL=Shiksha Elite <onboarding@resend.dev>

# Recipient email for new lead notifications
ADMIN_NOTIFICATION_EMAIL=officeshikshaelite@gmail.com
LEAD_EMAIL=officeshikshaelite@gmail.com

# ------------------------------------------------------------------------------
# 2. Google Sheets Automation via Google Apps Script Web App
# ------------------------------------------------------------------------------
# Google Apps Script Web App Deployment URL (Extensions > Apps Script > Deploy > Web app)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# Shared Secret configured in Google Apps Script Script Properties
GOOGLE_APPS_SCRIPT_SECRET=your_secure_shared_secret_here

# ------------------------------------------------------------------------------
# 3. Microsoft Graph & Excel Online Integration
# ------------------------------------------------------------------------------
# Microsoft Entra App Registration details (from portal.azure.com)
MICROSOFT_CLIENT_ID=your_microsoft_entra_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_entra_client_secret_here

# Delegated OAuth 2.0 Refresh Token (acquired via scripts/setup-microsoft-excel.mjs)
MICROSOFT_REFRESH_TOKEN=your_microsoft_delegated_refresh_token_here

# Microsoft Tenant ID ("common" for multi-tenant / personal, or your Azure Tenant GUID)
MICROSOFT_TENANT_ID=common

# Excel Workbook configuration
# Workbook Name in OneDrive: Shiksha_Elite_Contact_Enquiries.xlsx
MICROSOFT_EXCEL_FILE_PATH=Shiksha_Elite_Contact_Enquiries.xlsx
MICROSOFT_EXCEL_WORKSHEET_NAME=Contact Enquiries
MICROSOFT_EXCEL_TABLE_NAME=Contact_Enquiries

# Optional: Specific OneDrive Item ID if workbook is not in root
# MICROSOFT_EXCEL_ITEM_ID=01ABCDEF...

# ------------------------------------------------------------------------------
# 4. Firebase Client Configuration (Educator Auth & Firestore Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shikshaelite-e89c4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shikshaelite-e89c4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shikshaelite-e89c4.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=297456708134
NEXT_PUBLIC_FIREBASE_APP_ID=1:297456708134:web:fe9869e8f090082ed94e7
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-78PXBNG2FC

# ------------------------------------------------------------------------------
# 5. Site URL and Administrative Access
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://shikshaelite.com
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=YourSecureAdminPassword123!
