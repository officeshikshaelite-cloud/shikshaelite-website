# ==============================================================================
# ShikshaElite Production Environment Variables
# ==============================================================================
# Configure these variables in the Netlify Dashboard:
# Site configuration > Environment variables
# ==============================================================================

# Resend Email Service (Required for /api/submit-form)
RESEND_API_KEY=re_your_resend_api_key_here
LEAD_EMAIL=officeshikshaelite@gmail.com

# Firebase Client Configuration (Required for Educator Auth & Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key_here

# Optional: Production Site URL (used for canonical SEO and Open Graph)
NEXT_PUBLIC_SITE_URL=https://shikshaelite.netlify.app

# Optional: Admin Portal Credentials
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=YourSecureAdminPassword123!
